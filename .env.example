# ─────────────────────────────────────────────────────────────────────
# CareerCompass - Environment Variables Template
# ─────────────────────────────────────────────────────────────────────
# Usage: cp .env.example .env  then fill in real values.
# This file is the SINGLE SOURCE OF TRUTH for config (see ARCHITECTURE.md §16).
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────────────

# ─── LLM Endpoint (Main) ────────────────────────────────────────────
# OpenAI native:    fill OPENAI_API_KEY, leave OPENAI_BASE_URL empty.
# OpenAI-compatible (OpenRouter/Groq/Together/custom gateway/vLLM):
#                   fill both OPENAI_API_KEY and OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ─── Embedding Endpoint ──────────────────────────────────────────────
# Recommended: use Mistral (free, OpenAI-compatible endpoint).
# Falls back to OPENAI_* if EMBEDDING_API_KEY left empty.
EMBEDDING_API_KEY=                        # recommended: use MISTRAL_API_KEY
EMBEDDING_BASE_URL=https://api.mistral.ai/v1
EMBEDDING_MODEL=mistral-embed

# ─── Specialist Providers ───────────────────────────────────────────
# Required: CV parsing via Mistral OCR (PRD §9, ARCHITECTURE §8)
MISTRAL_API_KEY=

# Optional: web search for learning_resources enrichment
# If empty -> automatically uses DuckDuckGo (free, no key needed)
TAVILY_API_KEY=

# ─── Local Infrastructure ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///./data/career_compass.db

# ─── Observability ──────────────────────────────────────────────────
# Optional for dev. REQUIRED for demo (Cost/Latency/Accuracy/Hallucination).
# Sign up free at https://cloud.langfuse.com or self-host via Docker.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── App Settings (Optional) ────────────────────────────────────────
# CORS for dev (comma-separated); production should restrict origins.
CORS_ORIGINS=*
# Default ChromaDB path
CHROMA_DB_PATH=./data/chroma_db
